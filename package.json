{
  "name": "lanodus",
  "main": "dist/electron/main.js",
  "version": "1.0.0",
  "author": {
    "name": "Santiago Maria",
    "email": "santiagomariadev@gmail.com",
    "url": "https://santiagomaria.dev"
  },
  "private": true,
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "build": "bunx tsc -p tsconfig.electron.json",
    "electron": "bun run build && bunx electron dist/electron/main.js",
    "add-user": "bun scripts/add-allowed-user.ts",
    "check": "bunx tsc --noEmit",
    "test": "bun run build && node --test tests/*.test.js",
    "prepare:bundled-bun": "node scripts/prepare-bundled-bun.js",
    "release:appimage": "bun run build && bun run prepare:bundled-bun && bunx electron-builder build --linux AppImage"
  },
  "dependencies": {
    "bonjour": "^3.0.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^22.10.2",
    "electron": "^31.7.4",
    "electron-builder": "26.0.11",
    "typescript": "^5.6.3"
  },
  "build": {
    "appId": "com.lanodus.app",
    "productName": "Lanodus",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "public/**/*",
      "scripts/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "dist",
        "to": "dist"
      },
      {
        "from": "public",
        "to": "public"
      },
      {
        "from": "bundled/bin/bun",
        "to": "bin/bun"
      }
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility"
    }
  }
}
